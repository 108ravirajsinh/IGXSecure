# IGXSecure Backend Environment Variables
# Copy this to .env — never commit .env to Git

# Server
PORT=9000
HOST=0.0.0.0
NODE_ENV=development

# CORS — frontend URL
ALLOWED_ORIGIN=http://localhost

# Token encryption — must be exactly 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
TOKEN_SECRET=change_this_to_a_32_char_secret!!

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=igxsecure
DB_USER=igxuser
DB_PASSWORD=changeme_strong_password

# Meta OAuth (Phase 5)
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret
# META_REDIRECT_URI=https://yourdomain.com/igxsecure/api/auth/callback